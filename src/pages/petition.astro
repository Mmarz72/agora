---
import Base from '../layouts/Base.astro';
import { site, url } from '../site';

const { formUrl, goal, embed } = site.petition;

// Google Forms needs ?embedded=true to render inside a page.
function embedUrl(url: string) {
  try {
    const u = new URL(url);
    if (u.hostname === 'docs.google.com' && u.pathname.includes('/forms/')) {
      u.searchParams.set('embedded', 'true');
    }
    return u.toString();
  } catch {
    return url;
  }
}
---
<Base title="Petition" description={`Help start Agora at Princeton. We need ${goal} undergraduate signatures to apply for recognition as a student organization.`}>
  <div class="wrap">
    <h1 class="page-title">Help start Agora</h1>
    <p class="intro">
      To become a recognized student organization, Agora needs the signatures of at least {goal} Princeton
      undergraduates. It takes about a minute.
    </p>

    {formUrl && embed ? (
      <>
        <a class="button" href={formUrl} target="_blank" rel="noopener">Open the petition</a>
        <div class="form">
          <iframe src={embedUrl(formUrl)} title="Agora petition form" loading="lazy">Loading…</iframe>
        </div>
        <p class="muted small">
          If the form asks you to sign in and won’t load here, use the button above to open it in its own tab.
        </p>
      </>
    ) : formUrl ? (
      <>
        <a class="button" href={formUrl}>Sign the petition</a>
        <p class="muted small">You’ll sign in with your Princeton account, then fill in your name, NetID and class year.</p>
      </>
    ) : (
      <div class="pending">
        <p>The petition form isn’t linked yet.</p>
        {site.draft && <p class="muted small">Add its link as <code>petition.formUrl</code> in <code>src/site.ts</code>.</p>}
      </div>
    )}

    <p class="after muted">
      Want to know what you’d be supporting? <a href={url('/about')}>Read about Agora</a> or
      {' '}<a href={url('/constitution')}>its constitution</a>.
    </p>
  </div>
</Base>

<style>
  .intro { margin-bottom: 28px; }
  .form {
    margin-top: 32px;
    border-top: 2px solid var(--orange);
    max-width: 48rem;
  }
  iframe { display: block; width: 100%; height: 1100px; border: 0; }
  .small { font-size: 0.9375rem; margin-top: 12px; }
  .pending {
    border-top: 2px solid var(--orange);
    background: var(--wash);
    padding: 24px;
    max-width: 48rem;
  }
  .pending p { margin: 0; }
  .pending .small { margin-top: 8px; }
  code { font-size: 0.875em; }
  .after { margin-top: 40px; max-width: 36rem; }
</style>
