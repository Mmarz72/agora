---
import Base from '../layouts/Base.astro';
import { Content, getHeadings } from '../content/constitution.md';

const headings = getHeadings().filter((h) => h.depth === 2);
---
<Base title="Constitution" description="The constitution of Agora, a weekly reading and discussion society at Princeton University.">
  <div class="wrap">
    <h1 class="page-title">Constitution</h1>
    <div class="layout">
      <nav class="toc" aria-label="Articles">
        <ol>
          {headings.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
        </ol>
      </nav>
      <article class="doc">
        <Content />
      </article>
    </div>
  </div>
</Base>

<script>
  // Marks the article being read in the contents list.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  const heads = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))));
  let queued = false;

  function mark() {
    queued = false;
    const atEnd = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
    let current = 0;
    heads.forEach((h, i) => {
      if (h && h.getBoundingClientRect().top <= 120) current = i;
    });
    if (atEnd) current = heads.length - 1;
    links.forEach((a, i) => {
      if (i === current) a.setAttribute('aria-current', 'location');
      else a.removeAttribute('aria-current');
    });
  }

  addEventListener('scroll', () => {
    if (!queued) { queued = true; requestAnimationFrame(mark); }
  }, { passive: true });
  mark();
</script>

<style>
  .layout { display: grid; grid-template-columns: 15rem 1fr; gap: clamp(32px, 6vw, 96px); align-items: start; margin-top: 16px; }
  .toc { position: sticky; top: 24px; font-size: 0.9375rem; }
  .toc ol { list-style: none; margin: 0; padding: 0; }
  .toc a { display: block; padding: 5px 0; text-decoration: none; color: var(--stone); }
  .toc a:hover { color: var(--shade); text-decoration: underline; }
  .toc a[aria-current] {
    color: var(--shade);
    text-decoration: underline; text-decoration-thickness: 2px; text-decoration-color: var(--orange);
  }

  .doc { max-width: 38rem; font-size: 1.125rem; line-height: 1.65; }
  .doc :global(h2) {
    font-family: var(--display); font-size: 2.25rem; line-height: 1.1;
    margin: 64px 0 20px; scroll-margin-top: 24px;
  }
  .doc :global(h2:first-child) { margin-top: 0; }
  .doc :global(p strong) { font-weight: 700; margin-right: 2px; }
  .doc :global(ol) { padding-left: 1.5em; margin: 0 0 1.2em; }
  .doc :global(li) { margin-bottom: 0.6em; }
  .doc :global(li::marker) { color: var(--stone); }

  @media (max-width: 860px) {
    .layout { grid-template-columns: 1fr; }
    .toc { position: static; border-bottom: 1px solid var(--rule); padding-bottom: 16px; }
  }
</style>
