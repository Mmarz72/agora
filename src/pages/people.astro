---
import Base from '../layouts/Base.astro';
import { board } from '../data/board';
---
<Base title="People" description="Agora's Executive Board.">
  <div class="wrap">
    <h1 class="page-title">People</h1>

    <ul class="board">
      {board.map((o) => (
        <li>
          <span class="role">{o.role}</span>
          <span class:list={['name', { 'name--open': !o.name }]}>
            {o.name || 'To be announced'}
            {o.note && <span class="note">{o.note}</span>}
          </span>
        </li>
      ))}
    </ul>

    <p class="after muted">
      Any member can apply for the board each spring, and any member can lead a Sunday session.
    </p>
  </div>
</Base>

<style>
  .board { list-style: none; margin: 16px 0 0; padding: 0; border-top: 2px solid var(--orange); max-width: 52rem; }
  .board li {
    display: grid; grid-template-columns: 14rem 1fr; gap: 16px; align-items: baseline;
    padding: 18px 0; border-bottom: 1px solid var(--rule);
  }
  .role { color: var(--stone); }
  .name { font-size: 1.5rem; line-height: 1.25; }
  .name--open { color: var(--stone); }
  .note { display: block; font-size: 0.9375rem; color: var(--stone); }
  .after { margin-top: 32px; max-width: 36rem; }
  @media (max-width: 560px) {
    .board li { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
