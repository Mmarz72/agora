---
import Base from '../layouts/Base.astro';
import { upcoming, archiveBySemester, formatDate } from '../data/schedule';

const archive = archiveBySemester();
const short = { month: 'short', day: 'numeric' } as const;
---
<Base title="Readings" description="Agora's reading schedule and archive. Anyone at Princeton can read along.">
  <div class="wrap">
    <h1 class="page-title">Readings</h1>
    <p class="intro">Readings go out by Wednesday and take about ninety minutes. Anyone can read along.</p>

    <section>
      <h2>Coming up</h2>
      {upcoming.length === 0
        ? <p class="muted">The first schedule will be posted here.</p>
        : (
          <ol class="list">
            {upcoming.map((s) => (
              <li>
                <span class="date">{formatDate(s.date, short)}</span>
                <span class="work">
                  {s.link ? <a href={s.link}>{s.title}</a> : s.title}
                  <span class="by">{s.author}</span>
                </span>
                <span class="field">{s.field}</span>
              </li>
            ))}
          </ol>
        )}
    </section>

    {archive.map(([semester, list]) => (
      <section>
        <h2>{semester}</h2>
        <ol class="list">
          {list.map((s) => (
            <li>
              <span class="date">{formatDate(s.date, short)}</span>
              <span class="work">{s.title}<span class="by">{s.author}</span></span>
              <span class="field">{s.field}</span>
            </li>
          ))}
        </ol>
      </section>
    ))}

    <p class="propose muted">To propose a reading, tell the Director of Readings or bring it up at a session.</p>
  </div>
</Base>

<style>
  section { margin-top: clamp(40px, 6vw, 64px); }
  h2 { font-size: 1.125rem; font-weight: 700; margin-bottom: 12px; }
  .list { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--orange); }
  .list li {
    display: grid; grid-template-columns: 7rem 1fr 10rem; gap: 16px; align-items: baseline;
    padding: 16px 0; border-bottom: 1px solid var(--rule);
  }
  .date { color: var(--stone); font-variant-numeric: tabular-nums; }
  .work { font-size: 1.25rem; line-height: 1.3; }
  .by { display: block; font-size: 1rem; color: var(--stone); }
  .field { color: var(--stone); font-size: 0.9375rem; text-align: right; }
  .propose { margin-top: 40px; }

  @media (max-width: 640px) {
    .list li { grid-template-columns: 4.5rem 1fr; row-gap: 4px; }
    .field { grid-column: 2; text-align: left; }
  }
</style>
